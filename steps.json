{
    "develop": [
        "git reset --hard",
        "git checkout develop",
        "git pull origin develop",
		"pnpm i --frozen-lockfile",
		"pnpm run ci-build",
		"pnpm run ci-start"
	],
    "stage": [
		"git reset --hard",
		"git checkout stage",
		"git pull origin stage",
		"pnpm i --frozen-lockfile",
		"pnpm run ci-build",
		"pnpm run ci-start"
    ],
    "main": [
		"git reset --hard",
		"git checkout main",
		"git pull origin main",
		"pnpm i --frozen-lockfile",
		"pnpm run ci-build",
		"pnpm run ci-start"
    ]
}
