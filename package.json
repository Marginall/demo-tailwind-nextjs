{
  "name": "nextjs-multi-lang-app-basic",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "type": "module",
  "scripts": {
    "--- MAIN ---": "SECTION",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pr-ready": "pnpm run ts-check && pnpm run prettier:fix && pnpm run eslint:fix && pnpm run test",
    "pr-ready:coverage": "pnpm run ts-check && pnpm run prettier:fix && pnpm run eslint:fix && pnpm run test:coverage",
    "--- STORYBOOK ---": "SECTION",
    "sb-dev": "storybook dev --no-open -p 6006",
    "sb-build": "storybook build -o storybook-dist",
    "--- CODEGEN ---": "SECTION",
    "codegen": "pnpm run codegen:introspect && pnpm run codegen:generate",
    "codegen:introspect": "graphql-codegen --config \"./app/_library/graphql/codegen/introspect.ts\"",
    "codegen:generate": "graphql-codegen --config \"./app/_library/graphql/codegen/generate.ts\" && prettier --write \"./app/_library/graphql/*.ts\"",
    "--- CI/CD ---": "SECTION",
    "ci-check": "pnpm run eslint && pnpm run prettier",
    "ci-test": "pnpm run test",
    "ci-build": "pnpm run build",
    "ci-start": "pnpm run build",
    "ci-sb-build": "pnpm run sb-build",
    "--- HELPER ---": "SECTION",
    "eslint": "eslint ./app --max-warnings=0 --cache --cache-location ./.cache/eslint/app",
    "eslint:fix": "pnpm run eslint --fix",
    "prettier": "prettier --check \"./app/**/*.{ts,tsx,md,mdx,css}\"",
    "prettier:fix": "pnpm run prettier --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.all",
    "posttest:coverage": "istanbul-badges-readme && prettier --write \"./README.md\"",
    "test-unit": "vitest run --hideSkippedTests",
    "ts-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@apollo/client": "^3.12.5",
    "@apollo/experimental-nextjs-app-support": "^0.11.7",
    "@graphql-codegen/cli": "^5.0.3",
    "@heroui/react": "2.7.4",
    "@heroui/theme": "2.4.11",
    "@radix-ui/react-slot": "^1.1.1",
    "@types/apollo-upload-client": "^18.0.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@wezom/toolkit-array": "6.1.0",
    "apollo-upload-client": "^18.0.1",
    "clsx": "^2.1.1",
    "clsx-for-tailwind": "1.0.0",
    "date-fns": "^4.1.0",
    "dotenv-flow": "^4.1.0",
    "framer-motion": "11.17.0",
    "html-react-parser": "^5.2.5",
    "next": "^15.1.4",
    "next-intl": "^3.26.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "use-debounce": "^10.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/env": "^15.1.5",
    "@next/eslint-plugin-next": "^15.1.4",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@tailwindcss/postcss": "^4.0.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/dotenv-flow": "^3.3.3",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^2.1.8",
    "autoprefixer": "10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "istanbul-badges-readme": "^1.9.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "3.3.3",
    "storybook": "^8.4.7",
    "tailwindcss": "^4.0.14",
    "typescript-eslint": "^8.20.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
